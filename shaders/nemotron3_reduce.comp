#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer E{float v[];}e;
layout(set=0,binding=1,std430) readonly buffer S{float v[];}s;
layout(set=0,binding=2,std430) buffer H{float v[];}h;
layout(push_constant) uniform P{uint count;uint ranks;uint u0;uint u1;}p;
void main(){uint i=gl_GlobalInvocationID.x;if(i<p.count){float q=s.v[i];for(uint r=0;r<p.ranks;r++)q+=e.v[r*p.count+i];h.v[i]+=q;}}
