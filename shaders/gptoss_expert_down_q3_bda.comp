#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Activations { vec4 values[]; } activations;
layout(set = 0, binding = 1, std430) buffer AddressTable { uint64_t values[]; } addresses;
layout(set = 0, binding = 2, std430) readonly buffer Routing { float values[]; } routing;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float values[]; } output_data;
layout(set = 0, binding = 4, std430) readonly buffer Residual { float values[]; } residual;
layout(push_constant) uniform Params { uvec4 unused; } params;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ExpertData {
    uint values[];
};

const uint DIMENSION = 2880u;
const uint HIDDEN = 2880u;
const uint BLOCKS_PER_ROW = 90u;
const uint MLP2_BLOCK_U32 = 1687680u;
const uint MLP2_SCALE_BYTE = 9861120u;
const uint MLP2_BIAS_BYTE = 10120320u;

uint load_byte(ExpertData data, uint byte_offset) {
    const uint word = data.values[byte_offset >> 2u];
    return (word >> ((byte_offset & 3u) * 8u)) & 255u;
}
float load_bf16(ExpertData data, uint byte_offset) {
    const uint word = data.values[byte_offset >> 2u];
    return uintBitsToFloat(((word >> ((byte_offset & 2u) * 8u)) & 0xffffu) << 16u);
}
vec4 decode_q3(uvec4 code) {
    uvec4 bits = mix(uvec4(0x3f800000u), uvec4(0x40200000u),
                     greaterThan(code, uvec4(2u)));
    bits = mix(bits, uvec4(0x40900000u), greaterThan(code, uvec4(4u)));
    bits |= (((code & 1u) ^ 1u) << 31u);
    bits = mix(bits, uvec4(0u), equal(code, uvec4(0u)));
    return uintBitsToFloat(bits);
}
float dot_chunk(uint packed, uint activation_index) {
    const vec4 low = decode_q3(uvec4(packed, packed >> 3u, packed >> 6u,
                                     packed >> 9u) & 7u);
    const vec4 high = decode_q3(uvec4(packed >> 12u, packed >> 15u,
                                      packed >> 18u, packed >> 21u) & 7u);
    return dot(activations.values[activation_index], low) +
           dot(activations.values[activation_index + 1u], high);
}
float block_dot(ExpertData data, uint row, uint block, uint activation_offset) {
    const uint word_base = MLP2_BLOCK_U32 + (row * BLOCKS_PER_ROW + block) * 3u;
    const uint w0 = data.values[word_base];
    const uint w1 = data.values[word_base + 1u];
    const uint w2 = data.values[word_base + 2u];
    const uint input_base = activation_offset + block * 8u;
    return dot_chunk(w0 & 0xffffffu, input_base) +
           dot_chunk((w0 >> 24u) | ((w1 & 0xffffu) << 8u), input_base + 2u) +
           dot_chunk((w1 >> 16u) | ((w2 & 0xffu) << 16u), input_base + 4u) +
           dot_chunk(w2 >> 8u, input_base + 6u);
}
void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint row = gl_WorkGroupID.x * 4u + gl_LocalInvocationID.y;
    float total = 0.0;
    for (uint rank = 0u; rank < 4u; ++rank) {
        const uint expert = uint(round(routing.values[rank]));
        const uint64_t address = addresses.values[expert];
        if (address == 0ul) continue;
        ExpertData data = ExpertData(address);
        float sum = 0.0;
        if (row < DIMENSION) {
            for (uint block = lane; block < BLOCKS_PER_ROW; block += 64u) {
                const float scale = uintBitsToFloat(
                    load_byte(data, MLP2_SCALE_BYTE + row * BLOCKS_PER_ROW + block) << 23u);
                sum += block_dot(data, row, block, rank * (HIDDEN / 4u)) * scale;
            }
        }
        sum = subgroupAdd(sum);
        if (lane == 0u && row < DIMENSION)
            total += (sum + load_bf16(data, MLP2_BIAS_BYTE + row * 2u)) *
                     routing.values[4u + rank];
    }
    if (lane == 0u && row < DIMENSION)
        output_data.values[row] = total + residual.values[row];
}
