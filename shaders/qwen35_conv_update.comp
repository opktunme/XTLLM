#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer InputData { float v[]; } input_data;
layout(set=0,binding=1,std430) readonly buffer Weight { float v[]; } weight;
layout(set=0,binding=2,std430) buffer State { float v[]; } state;
layout(set=0,binding=3,std430) writeonly buffer OutputData { float v[]; } output_data;
layout(push_constant) uniform P { uint channels; uint kernel; uint unused0; uint unused1; } p;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.channels)return;uint b=i*p.kernel;for(uint k=0u;k+1u<p.kernel;++k)state.v[b+k]=state.v[b+k+1u];state.v[b+p.kernel-1u]=input_data.v[i];float x=0.0;for(uint k=0u;k<p.kernel;++k)x+=state.v[b+k]*weight.v[b+k];output_data.v[i]=x/(1.0+exp(-x));}
