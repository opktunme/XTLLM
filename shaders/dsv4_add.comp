#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Accumulator { float values[]; } accumulator;
layout(set = 0, binding = 1, std430) readonly buffer Addend { float values[]; } addend;
layout(push_constant) uniform Params {
    uint count;
    uint unused0;
    uint unused1;
    uint unused2;
} params;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index < params.count) {
        if (params.unused0 != 0u) accumulator.values[index] = 0.0;
        else accumulator.values[index] += addend.values[index];
    }
}
