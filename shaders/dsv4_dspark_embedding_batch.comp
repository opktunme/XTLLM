#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer PackedEmbedding { uint values[]; } weights;
layout(set = 0, binding = 1, std430) readonly buffer RowScales { float values[]; } scales;
layout(set = 0, binding = 2, std430) readonly buffer TokenData { uint values[]; } token_data;
layout(set = 0, binding = 3, std430) writeonly buffer OutputData { float values[]; } output_data;
layout(push_constant) uniform Params { uint vocab_size; uint dimension; uint row_stride_u32; uint hc; } params;

void main() {
    const uint column = gl_GlobalInvocationID.x;
    const uint copy = gl_WorkGroupID.y;
    const uint token_index = copy / params.hc;
    const uint hc_index = copy - token_index * params.hc;
    if (column >= params.dimension) return;
    const uint token = token_data.values[token_index];
    float value = 0.0;
    if (token < params.vocab_size) {
        const uint packed = weights.values[token * params.row_stride_u32 + (column >> 2u)];
        const int q = bitfieldExtract(int(packed), int((column & 3u) * 8u), 8);
        value = float(q) * scales.values[token];
    }
    output_data.values[(token_index * params.hc + hc_index) * params.dimension + column] = value;
}
