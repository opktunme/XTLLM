#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Left { float values[]; } left_data;
layout(set = 0, binding = 1, std430) readonly buffer Right { float values[]; } right_data;
layout(set = 0, binding = 2, std430) writeonly buffer OutputData { float values[]; } output_data;

layout(push_constant) uniform Params { uint count; uint unused0; uint unused1; uint unused2; } params;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index < params.count) output_data.values[index] = left_data.values[index] + right_data.values[index];
}
