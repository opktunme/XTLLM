#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x=64,local_size_y=4,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer A{uint v[];} a;
layout(set=0,binding=1,std430) readonly buffer W{uint v[];} w;
layout(set=0,binding=2,std430) readonly buffer S{uint v[];} s;
layout(set=0,binding=3,std430) writeonly buffer O{float v[];} o;
layout(push_constant) uniform P{uint groups;uint rows_per_group;uint inner;uint activation_scale_u32;} p;
const uint GS=64u,WG=8u,LPG=2u,GPW=32u;
uint sn(uint n){uint b=(n&15u)|((n&240u)<<4u)|((n&3840u)<<8u)|((n&61440u)<<12u);uint q=b&0x08080808u;return b|(q<<1u)|(q<<2u)|(q<<3u)|(q<<4u);}
int dq(uint x,uint a0,uint a1){return dotPacked4x8EXT(int(a0),int(sn(x&65535u)))+dotPacked4x8EXT(int(a1),int(sn(x>>16u)));}
float bf(uint i){uint x=(s.v[i>>1u]>>((i&1u)*16u))&65535u;return uintBitsToFloat(x<<16u);}
uint la(uint base,uint i,uint n){return i<n?a.v[base+i]:0u;}
void main(){uint batch=gl_WorkGroupID.y;if(batch>=p.groups)return;uint lane=gl_LocalInvocationID.x,frag=lane&(LPG-1u),lg=lane/LPG;
uint lr=gl_WorkGroupID.x*4u+gl_LocalInvocationID.y,ps=(p.inner+3u)>>2u,ab=batch*ps,blocks=(p.inner+127u)>>7u,gc=(p.inner+GS-1u)/GS,wr=gc*WG;float sum=0.0;
if(lr<p.rows_per_group){uint row=batch*p.rows_per_group+lr;for(uint g=lg;g<gc;g+=GPW){uint wi=frag*4u,ai=g*16u+wi*2u;uint a0=la(ab,ai,ps),a1=la(ab,ai+1u,ps),a2=la(ab,ai+2u,ps),a3=la(ab,ai+3u,ps),a4=la(ab,ai+4u,ps),a5=la(ab,ai+5u,ps),a6=la(ab,ai+6u,ps),a7=la(ab,ai+7u,ps);uint base=row*wr+wi*gc+g;int d=dq(w.v[base],a0,a1)+dq(w.v[base+gc],a2,a3)+dq(w.v[base+2u*gc],a4,a5)+dq(w.v[base+3u*gc],a6,a7);sum+=float(d)*uintBitsToFloat(a.v[p.activation_scale_u32+batch*blocks+(g>>1u)])*bf(row*gc+g);}sum=subgroupAdd(sum);if(lane==0u)o.v[row]=sum;}}
