#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Wave32 specialization for Q4 GEMVs with small K.  It keeps the same tensor
// and push-constant ABI as dsv4_q4g64t_gemv while avoiding idle Wave64 lanes.
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer QuantizedActivations { uint values[]; } activations;
layout(set = 0, binding = 1, std430) readonly buffer PackedWeights { uint values[]; } weights;
layout(set = 0, binding = 2, std430) readonly buffer PackedWeightScales { uint values[]; } weight_scales;
layout(set = 0, binding = 3, std430) writeonly buffer OutputData { float values[]; } output_data;
layout(push_constant) uniform Params { uint rows; uint inner; uint activation_scale_u32; uint output_offset; } params;

const uint Q4_GROUP_SIZE=64u,Q4_WORDS_PER_GROUP=8u,LANES_PER_GROUP=2u,GROUPS_PER_WAVE=16u;
uint signed_nibbles(uint n){uint b=(n&0x000fu)|((n&0x00f0u)<<4u)|((n&0x0f00u)<<8u)|((n&0xf000u)<<12u);uint s=b&0x08080808u;return b|(s<<1u)|(s<<2u)|(s<<3u)|(s<<4u);}
int dot_q4x8(uint packed,uint a0,uint a1){return dotPacked4x8EXT(int(a0),int(signed_nibbles(packed&0xffffu)))+dotPacked4x8EXT(int(a1),int(signed_nibbles(packed>>16u)));}
float load_bf16(uint index){uint packed=weight_scales.values[index>>1u];uint value=(packed>>((index&1u)*16u))&0xffffu;return uintBitsToFloat(value<<16u);}
uint load_activation(uint index,uint stride){return index<stride?activations.values[index]:0u;}
void main(){uint lane=gl_LocalInvocationID.x,fragment=lane&(LANES_PER_GROUP-1u),lane_group=lane/LANES_PER_GROUP,first_row=gl_WorkGroupID.x*8u,packed_stride=(params.inner+3u)>>2u,q4_groups=(params.inner+Q4_GROUP_SIZE-1u)/Q4_GROUP_SIZE,words_per_row=q4_groups*Q4_WORDS_PER_GROUP;float sums[8]=float[8](0,0,0,0,0,0,0,0);for(uint group=lane_group;group<q4_groups;group+=GROUPS_PER_WAVE){uint wig=fragment*4u,aw=group*16u+wig*2u;uint a0=load_activation(aw,packed_stride),a1=load_activation(aw+1u,packed_stride),a2=load_activation(aw+2u,packed_stride),a3=load_activation(aw+3u,packed_stride),a4=load_activation(aw+4u,packed_stride),a5=load_activation(aw+5u,packed_stride),a6=load_activation(aw+6u,packed_stride),a7=load_activation(aw+7u,packed_stride);float as=uintBitsToFloat(activations.values[params.activation_scale_u32+(group>>1u)]);for(uint r=0u;r<8u;++r){uint row=first_row+r;if(row<params.rows){uint base=row*words_per_row+wig*q4_groups+group;int d=dot_q4x8(weights.values[base],a0,a1);d+=dot_q4x8(weights.values[base+q4_groups],a2,a3);d+=dot_q4x8(weights.values[base+2u*q4_groups],a4,a5);d+=dot_q4x8(weights.values[base+3u*q4_groups],a6,a7);sums[r]+=float(d)*as*load_bf16(row*q4_groups+group);}}}for(uint r=0u;r<8u;++r)sums[r]=subgroupAdd(sums[r]);if(lane==0u)for(uint r=0u;r<8u;++r){uint row=first_row+r;if(row<params.rows)output_data.values[params.output_offset+row]=sums[r];}}
