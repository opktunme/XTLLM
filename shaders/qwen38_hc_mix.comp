#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Normed { float v[]; } normed;
layout(set=0,binding=1,std430) readonly buffer MixLogits { float v[]; } mix_logits;
layout(set=0,binding=2,std430) writeonly buffer Mixed { float v[]; } mixed;
layout(set=0,binding=3,std430) readonly buffer Dummy { uint v; } dummy;
layout(push_constant) uniform P { uint dimension; uint branches; uint unused0; uint unused1; } p;
void main(){uint i=gl_GlobalInvocationID.x;if(i<p.dimension){float s=0.0;for(uint b=0u;b<p.branches;++b){uint x=b*p.dimension+i;s+=normed.v[x]/(1.0+exp(-mix_logits.v[x]));}mixed.v[i]=s/float(p.branches);}}
