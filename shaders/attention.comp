#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer QKV { float values[]; } qkv;
layout(set = 0, binding = 1, std430) writeonly buffer Context { float values[]; } context;

layout(push_constant) uniform Params {
    uint tokens;
    uint model_dimension;
    uint heads;
    uint head_dimension;
} params;

const uint MAX_TOKENS = 64;

void main() {
    const uint token = gl_GlobalInvocationID.x;
    const uint head = gl_GlobalInvocationID.y;
    if (token >= params.tokens || head >= params.heads) return;

    float scores[MAX_TOKENS];
    float maximum = -3.402823466e+38;
    const uint qkv_width = 3 * params.model_dimension;
    const uint query_base = token * qkv_width + head * params.head_dimension;
    const float scale = inversesqrt(float(params.head_dimension));

    for (uint source = 0; source <= token; ++source) {
        const uint key_base = source * qkv_width + params.model_dimension + head * params.head_dimension;
        float score = 0.0;
        for (uint d = 0; d < params.head_dimension; ++d) {
            score += qkv.values[query_base + d] * qkv.values[key_base + d];
        }
        scores[source] = score * scale;
        maximum = max(maximum, scores[source]);
    }

    float denominator = 0.0;
    for (uint source = 0; source <= token; ++source) {
        scores[source] = exp(scores[source] - maximum);
        denominator += scores[source];
    }

    for (uint d = 0; d < params.head_dimension; ++d) {
        float value = 0.0;
        for (uint source = 0; source <= token; ++source) {
            const uint value_index = source * qkv_width + 2 * params.model_dimension +
                                     head * params.head_dimension + d;
            value += (scores[source] / denominator) * qkv.values[value_index];
        }
        context.values[token * params.model_dimension + head * params.head_dimension + d] = value;
    }
}
