#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x=64,local_size_y=4,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer A{uint v[];} a;
layout(set=0,binding=1,std430) readonly buffer E{uint v[];} e;
layout(set=0,binding=2,std430) readonly buffer R{uint v[];} route;
layout(set=0,binding=3,std430) writeonly buffer O{float v[];} out_data;
layout(push_constant) uniform P{uint rank;uint activation_scale_u32;uint unused0;uint unused1;} p;
const uint DIM=4096u,GROUPS=32u,WORDS=8u;
const uint W2_WEIGHT=2228224u,W2_SCALE_BYTE=13107200u;
uint sn(uint n){uint b=(n|(n<<8u))&0x00ff00ffu;b=(b|(b<<4u))&0x0f0f0f0fu;return b|((b&0x08080808u)*31u);}
int dq(uint w,uint a0,uint a1){return dotPacked4x8EXT(int(a0),int(sn(w&65535u)))+dotPacked4x8EXT(int(a1),int(sn(w>>16u)));}
float bf(uint index){uint x=e.v[(W2_SCALE_BYTE>>2u)+(index>>1u)];uint h=(x>>((index&1u)*16u))&65535u;return uintBitsToFloat(h<<16u);}
int dotrow(uint row,uint group,uint frag){uint wi=frag*4u,base=W2_WEIGHT+row*(GROUPS*WORDS)+wi*GROUPS+group,ab=group*16u+wi*2u;return dq(e.v[base],a.v[ab],a.v[ab+1u])+dq(e.v[base+GROUPS],a.v[ab+2u],a.v[ab+3u])+dq(e.v[base+2u*GROUPS],a.v[ab+4u],a.v[ab+5u])+dq(e.v[base+3u*GROUPS],a.v[ab+6u],a.v[ab+7u]);}
void main(){uint lane=gl_LocalInvocationID.x,frag=lane&1u,group=lane>>1u,row=gl_WorkGroupID.x*4u+gl_LocalInvocationID.y;float sum=0.0;
if(row<DIM){float as=uintBitsToFloat(a.v[p.activation_scale_u32+group*2u+frag]);sum=float(dotrow(row,group,frag))*as*bf(row*GROUPS+group);sum=subgroupAdd(sum);if(lane==0u)out_data.v[p.rank*DIM+row]=sum*uintBitsToFloat(route.v[6u+p.rank]);}}
