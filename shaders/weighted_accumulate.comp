#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer ExpertOutput { float values[]; } expert_output;
layout(set = 0, binding = 1, std430) buffer Accumulator { float values[]; } accumulator;

layout(push_constant) uniform Params {
    uint count;
    float weight;
    uint clear;
    uint unused;
} params;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index >= params.count) return;
    const float weighted = params.weight * expert_output.values[index];
    accumulator.values[index] = params.clear != 0 ? weighted : accumulator.values[index] + weighted;
}
