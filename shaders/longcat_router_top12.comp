#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Logits { float v[]; } logits;
layout(set=0,binding=1,std430) readonly buffer Bias { float v[]; } bias;
layout(set=0,binding=2,std430) writeonly buffer Routes { uint v[]; } routes;
layout(set=0,binding=3,std430) readonly buffer Dummy { uint v; } dummy;
layout(push_constant) uniform P { uint experts; uint top_k; uint unused0; uint unused1; } p;
const uint E=384u,K=12u,W=16u;shared float prob[E];shared float choice[E];
void main(){uint lane=gl_LocalInvocationID.x;float mx=-3.402823466e+38;for(uint e=lane;e<E;e+=64u)mx=max(mx,logits.v[e]);mx=subgroupMax(mx);float total=0.0;for(uint e=lane;e<E;e+=64u)total+=exp(logits.v[e]-mx);total=subgroupAdd(total);for(uint e=lane;e<E;e+=64u){prob[e]=exp(logits.v[e]-mx)/total;choice[e]=prob[e]+bias.v[e];}barrier();if(lane==0u){uint ids[K];float identity=0.0;for(uint r=0u;r<K;++r){float best=-3.402823466e+38;uint id=0u;for(uint e=0u;e<E;++e){bool used=false;for(uint q=0u;q<r;++q)used=used||ids[q]==e;if(!used&&choice[e]>best){best=choice[e];id=e;}}ids[r]=id;float weight=prob[id]*6.0;routes.v[r]=id;routes.v[W+r]=floatBitsToUint(weight);if(id>=256u)identity+=weight;}routes.v[28u]=floatBitsToUint(identity);}}
