#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#ifndef DSV4_INDEX_ROWS
#define DSV4_INDEX_ROWS 8
#endif
layout(local_size_x=64,local_size_y=DSV4_INDEX_ROWS,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Queries{uint v[];} queries;
layout(set=0,binding=1,std430) readonly buffer IndexKV{uint v[];} keys;
layout(set=0,binding=2,std430) readonly buffer HeadWeights{float v[];} weights;
layout(set=0,binding=3,std430) writeonly buffer Scores{float v[];} scores;
layout(set=0,binding=4,std430) readonly buffer DummyA{uint v;} a;
layout(set=0,binding=5,std430) readonly buffer DummyB{uint v;} b;
layout(push_constant) uniform P{uint count;uint head_dim;uint heads;uint unused;} p;

int fp4_integer(uint nibble){
    uint code=nibble&7u;int value;
    if(code==0u)value=0;else if(code==1u)value=1;else if(code==2u)value=2;
    else if(code==3u)value=3;else if(code==4u)value=4;else if(code==5u)value=6;
    else if(code==6u)value=8;else value=12;
    return (nibble&8u)!=0u?-value:value;
}
uint signed4(uint word,uint first){
    uint packed=0u;for(uint i=0u;i<4u;++i){uint nibble=(word>>((first+i)*4u))&15u;
        packed|=(uint(fp4_integer(nibble))&255u)<<(i*8u);}return packed;
}

void main(){
    uint position=gl_WorkGroupID.x*uint(DSV4_INDEX_ROWS)+gl_LocalInvocationID.y;
    uint head=gl_LocalInvocationID.x;
    if(position>=p.count||head>=p.heads)return;
    const uint stride=17u;uint qbase=head*stride,kbase=position*stride;
    uint qexp=queries.v[qbase+16u],kexp=keys.v[kbase+16u];float dotv=0.0;
    for(uint group=0u;group<4u;++group){int isum=0;for(uint word=0u;word<4u;++word){
        uint qw=queries.v[qbase+group*4u+word],kw=keys.v[kbase+group*4u+word];
        isum+=dotPacked4x8EXT(int(signed4(qw,0u)),int(signed4(kw,0u)));
        isum+=dotPacked4x8EXT(int(signed4(qw,4u)),int(signed4(kw,4u)));}
        float qs=uintBitsToFloat(((qexp>>(group*8u))&255u)<<23u);
        float ks=uintBitsToFloat(((kexp>>(group*8u))&255u)<<23u);
        dotv+=float(isum)*0.25*qs*ks;}
    float contribution=max(dotv,0.0)*weights.v[head];
    float total=subgroupAdd(contribution);
    if(head==0u)scores.v[position]=total;
}
