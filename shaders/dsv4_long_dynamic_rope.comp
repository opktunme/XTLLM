#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

// DeepSeek decode RMSNorm + adjacent-pair partial RoPE without a position table.
// mode=0 uses ordinary RoPE; mode=1 uses the checkpoint's compressed YaRN RoPE.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer InputData{float v[];} input_data;
layout(set=0,binding=1,std430) readonly buffer Gamma{float v[];} gamma_data;
layout(set=0,binding=2,std430) writeonly buffer OutputData{float v[];} output_data;
layout(set=0,binding=3,std430) readonly buffer DummyA{uint v;} a;
layout(set=0,binding=4,std430) readonly buffer DummyB{uint v;} b;
layout(set=0,binding=5,std430) readonly buffer DummyC{uint v;} c;
layout(push_constant) uniform P{uint epsilon_bits;uint position;uint mode;uint vectors;} p;

shared float tile[512];

float rope_frequency(uint frequency){
    const float base=p.mode==0u?10000.0:160000.0;
    float value=1.0/pow(base,float(frequency*2u)/64.0);
    if(p.mode!=0u){
        const float pi=3.14159265358979323846;
        float low=floor(64.0*log(65536.0/(32.0*2.0*pi))/(2.0*log(base)));
        float high=ceil(64.0*log(65536.0/(1.0*2.0*pi))/(2.0*log(base)));
        low=max(low,0.0); high=min(high,63.0);
        if(low==high) high+=0.001;
        float ramp=clamp((float(frequency)-low)/(high-low),0.0,1.0);
        float blend=1.0-ramp;
        value=value/16.0*(1.0-blend)+value*blend;
    }
    return value;
}

void main(){
    uint head=gl_WorkGroupID.x,lane=gl_LocalInvocationID.x;
    if(head>=p.vectors)return;
    uint base=head*512u;
    float square_sum=0.0;
    for(uint step=0u;step<8u;++step){uint d=lane+step*64u;float x=input_data.v[base+d];tile[d]=x;square_sum+=x*x;}
    square_sum=subgroupAdd(square_sum);
    float inv=inversesqrt(square_sum/512.0+uintBitsToFloat(p.epsilon_bits));
    barrier();
    for(uint step=0u;step<8u;++step){
        uint d=lane+step*64u;
        float x=tile[d]*inv*gamma_data.v[d];
        if(d>=448u){
            uint ro=d-448u,pair=448u+(ro^1u),f=ro>>1u;
            float y=tile[pair]*inv*gamma_data.v[pair];
            float angle=float(p.position)*rope_frequency(f);
            float co=cos(angle),si=sin(angle);
            x=(ro&1u)==0u?x*co-y*si:x*co+y*si;
        }
        output_data.v[base+d]=x;
    }
}
