#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

// Step-3.7 stores RMSNorm weights as an offset from one.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer InputData { float values[]; } input_data;
layout(set=0,binding=1,std430) readonly buffer GammaData { float values[]; } gamma_data;
layout(set=0,binding=2,std430) writeonly buffer OutputData { float values[]; } output_data;
layout(set=0,binding=3,std430) readonly buffer Dummy { uint value; } dummy;
layout(push_constant) uniform Params { uint rows; uint columns; uint epsilon_bits; uint output_offset; } params;

void main(){
    const uint row=gl_WorkGroupID.x,lane=gl_LocalInvocationID.x;
    if(row>=params.rows)return;
    float square_sum=0.0;
    for(uint column=lane;column<params.columns;column+=64u){
        float x=input_data.values[row*params.columns+column];square_sum+=x*x;
    }
    square_sum=subgroupAdd(square_sum);
    float inv_rms=inversesqrt(square_sum/float(params.columns)+uintBitsToFloat(params.epsilon_bits));
    for(uint column=lane;column<params.columns;column+=64u){
        output_data.values[params.output_offset+row*params.columns+column]=
            input_data.values[row*params.columns+column]*inv_rms*(gamma_data.values[column]+1.0);
    }
}
