#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer PackedWeights { uint values[]; } weights;
layout(set = 0, binding = 1, std430) readonly buffer Scales { float values[]; } scales;
layout(set = 0, binding = 2, std430) writeonly buffer OutputData { float values[]; } output_data;

layout(push_constant) uniform Params {
    uint token;
    uint dimension;
    uint packed_stride;
    uint unused;
} params;

void main() {
    const uint column = gl_GlobalInvocationID.x;
    if (column >= params.dimension) return;
    const uint packed = weights.values[params.token * params.packed_stride + (column >> 2u)];
    const uint byte_value = (packed >> ((column & 3u) * 8u)) & 0xffu;
    int quantized = int(byte_value);
    if (quantized >= 128) quantized -= 256;
    output_data.values[column] = float(quantized) * scales.values[params.token];
}
