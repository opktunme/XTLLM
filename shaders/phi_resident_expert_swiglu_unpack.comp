#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Activations { float values[]; } activations;
layout(set = 0, binding = 1, std430) readonly buffer ExpertBlock { uint values[]; } experts;
layout(set = 0, binding = 2, std430) readonly buffer Routing { float values[]; } routing;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float values[]; } output_data;
layout(push_constant) uniform Params { uint unused0; uint unused1; uint unused2; uint unused3; } params;

const uint HIDDEN=448u,GATE_ROWS=896u,GATE_STRIDE=1024u,DOWN_ROWS=4096u,DOWN_STRIDE=112u;
const uint EXPERT_WORDS=GATE_ROWS+GATE_ROWS*GATE_STRIDE+DOWN_ROWS+DOWN_ROWS*DOWN_STRIDE;

void main() {
    const uint lane=gl_LocalInvocationID.x,row=gl_WorkGroupID.x*4u+gl_LocalInvocationID.y;
    const uint expert0=uint(round(routing.values[0]))*EXPERT_WORDS;
    const uint expert1=uint(round(routing.values[1]))*EXPERT_WORDS;
    float g0=0.0,u0=0.0,g1=0.0,u1=0.0;
    if(row<HIDDEN){
        const uint gb0=expert0+GATE_ROWS+row*GATE_STRIDE,ub0=expert0+GATE_ROWS+(row+HIDDEN)*GATE_STRIDE;
        const uint gb1=expert1+GATE_ROWS+row*GATE_STRIDE,ub1=expert1+GATE_ROWS+(row+HIDDEN)*GATE_STRIDE;
        for(uint p=lane;p<GATE_STRIDE;p+=64u){
            const uint k=p*4u;
            const vec4 x=vec4(activations.values[k],activations.values[k+1u],activations.values[k+2u],activations.values[k+3u]);
            g0+=dot(x,unpackSnorm4x8(experts.values[gb0+p]));
            u0+=dot(x,unpackSnorm4x8(experts.values[ub0+p]));
            g1+=dot(x,unpackSnorm4x8(experts.values[gb1+p]));
            u1+=dot(x,unpackSnorm4x8(experts.values[ub1+p]));
        }
    }
    g0=subgroupAdd(g0);u0=subgroupAdd(u0);g1=subgroupAdd(g1);u1=subgroupAdd(u1);
    if(lane==0u&&row<HIDDEN){
        g0*=127.0*uintBitsToFloat(experts.values[expert0+row]);u0*=127.0*uintBitsToFloat(experts.values[expert0+row+HIDDEN]);
        g1*=127.0*uintBitsToFloat(experts.values[expert1+row]);u1*=127.0*uintBitsToFloat(experts.values[expert1+row+HIDDEN]);
        output_data.values[row]=(g0/(1.0+exp(-g0)))*u0;
        output_data.values[HIDDEN+row]=(g1/(1.0+exp(-g1)))*u1;
    }
}
