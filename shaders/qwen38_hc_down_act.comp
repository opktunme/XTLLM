#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) buffer Values { float v[]; } values;
layout(set=0,binding=1,std430) readonly buffer DummyA { uint v; } a;
layout(set=0,binding=2,std430) readonly buffer DummyB { uint v; } b;
layout(set=0,binding=3,std430) readonly buffer DummyC { uint v; } c;
layout(push_constant) uniform P { uint count; uint divisor_bits; uint unused0; uint unused1; } p;
void main(){uint i=gl_GlobalInvocationID.x;if(i<p.count){float x=values.v[i]/uintBitsToFloat(p.divisor_bits);values.v[i]=x/(1.0+exp(-x));}}
