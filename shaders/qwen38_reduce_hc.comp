#version 450
// DwarfStar's MoE-reduce-plus-HC-combine idea, with XTLLM's existing order
// (shared first, then routed ranks) and its own Q4 activation conventions.
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Experts { float v[]; } experts;
layout(set=0,binding=1,std430) readonly buffer Shared { float v[]; } shared_data;
layout(set=0,binding=2,std430) readonly buffer Gate { float v[]; } gate;
layout(set=0,binding=3,std430) readonly buffer Injection { float v[]; } injection;
layout(set=0,binding=4,std430) buffer Hyper { float v[]; } hyper;
layout(set=0,binding=5,std430) writeonly buffer Block { float v[]; } block_data;
layout(push_constant) uniform P { uint dimension; uint ranks; uint branches; uint divisor_bits; } p;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i>=p.dimension) return;
    precise float s=shared_data.v[i]/(1.0+exp(-gate.v[0]));
    for (uint rank=0u; rank<p.ranks; ++rank) s+=experts.v[rank*p.dimension+i];
    block_data.v[i]=s;
    // Keep the completed reduction separate, then the same residual update
    // expression as qwen38_hc_inject (including its contraction policy).
    for (uint b=0u; b<p.branches; ++b) {
        float w=2.0/(1.0+exp(-injection.v[b]/uintBitsToFloat(p.divisor_bits)));
        hyper.v[b*p.dimension+i]+=s*w;
    }
}
