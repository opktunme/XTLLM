void main(){uint rank=gl_WorkGroupID.y;if(rank>=TOPK)return;uint rb=routes.v[SLOT_OFFSET+rank]*RECORD_WORDS,lane=gl_LocalInvocationID.x,frag=lane&1u,group=lane>>1u,first=gl_WorkGroupID.x*8u;float sum[8]=float[8](0,0,0,0,0,0,0,0);if(group<GROUPS){uint base0=rb+(DOWN_W>>2u)+frag*3u*GROUPS+group,w0,w1,w2,c0,c1,c2,c3,ab=rank*160u+group*16u+frag*8u;float as=uintBitsToFloat(act.v[p.activation_scale_u32+rank*5u+(group>>1u)]);for(uint r=0u;r<8u;++r){uint row=first+r;if(row<DIM){uint base=base0+row*(GROUPS*WORDS);w0=arena.v[base];w1=arena.v[base+GROUPS];w2=arena.v[base+2u*GROUPS];c0=w0&0xffffffu;c1=(w0>>24u)|((w1&0xffffu)<<8u);c2=(w1>>16u)|((w2&255u)<<16u);c3=w2>>8u;int s=d3(c0,act.v[ab],act.v[ab+1u])+d3(c1,act.v[ab+2u],act.v[ab+3u])+d3(c2,act.v[ab+4u],act.v[ab+5u])+d3(c3,act.v[ab+6u],act.v[ab+7u]);sum[r]+=float(s)*as*bf(rb,row*GROUPS+group);}}}for(uint r=0u;r<8u;++r)sum[r]=subgroupAdd(sum[r]);if(lane==0u){float rw=uintBitsToFloat(routes.v[16u+rank]);for(uint r=0u;r<8u;++r){uint row=first+r;if(row<DIM)out_data.v[rank*DIM+row]=sum[r]*rw;}}}
