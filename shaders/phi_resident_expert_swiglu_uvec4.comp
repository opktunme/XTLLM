#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x=64,local_size_y=4,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Activations{vec4 values[];} activations;
layout(set=0,binding=1,std430) readonly buffer ExpertBlock{uvec4 values[];} experts;
layout(set=0,binding=2,std430) readonly buffer Routing{float values[];} routing;
layout(set=0,binding=3,std430) writeonly buffer Output{float values[];} output_data;
layout(push_constant) uniform Params{uint unused0;uint unused1;uint unused2;uint unused3;}params;

const uint HIDDEN=448u,GATE_ROWS=896u,GATE_STRIDE=1024u,DOWN_ROWS=4096u,DOWN_STRIDE=112u;
const uint EXPERT_WORDS=GATE_ROWS+GATE_ROWS*GATE_STRIDE+DOWN_ROWS+DOWN_ROWS*DOWN_STRIDE;
uint scalar_word(uint index){uvec4 v=experts.values[index/4u];return v[index&3u];}

void main(){
 const uint lane=gl_LocalInvocationID.x,row=gl_WorkGroupID.x*4u+gl_LocalInvocationID.y;
 const uint e0=uint(round(routing.values[0]))*EXPERT_WORDS,e1=uint(round(routing.values[1]))*EXPERT_WORDS;
 float g0=0.0,u0=0.0,g1=0.0,u1=0.0;
 if(row<HIDDEN){
  const uint gb0=(e0+GATE_ROWS+row*GATE_STRIDE)/4u,ub0=(e0+GATE_ROWS+(row+HIDDEN)*GATE_STRIDE)/4u;
  const uint gb1=(e1+GATE_ROWS+row*GATE_STRIDE)/4u,ub1=(e1+GATE_ROWS+(row+HIDDEN)*GATE_STRIDE)/4u;
  const uint vector_stride=GATE_STRIDE/4u;
  for(uint v=lane;v<vector_stride;v+=64u){
   const uvec4 wg0=experts.values[gb0+v],wu0=experts.values[ub0+v];
   const uvec4 wg1=experts.values[gb1+v],wu1=experts.values[ub1+v];
   const uint p=v*4u;
   const vec4 x0=activations.values[p],x1=activations.values[p+1u],x2=activations.values[p+2u],x3=activations.values[p+3u];
   g0+=dot(x0,unpackSnorm4x8(wg0.x))+dot(x1,unpackSnorm4x8(wg0.y))+dot(x2,unpackSnorm4x8(wg0.z))+dot(x3,unpackSnorm4x8(wg0.w));
   u0+=dot(x0,unpackSnorm4x8(wu0.x))+dot(x1,unpackSnorm4x8(wu0.y))+dot(x2,unpackSnorm4x8(wu0.z))+dot(x3,unpackSnorm4x8(wu0.w));
   g1+=dot(x0,unpackSnorm4x8(wg1.x))+dot(x1,unpackSnorm4x8(wg1.y))+dot(x2,unpackSnorm4x8(wg1.z))+dot(x3,unpackSnorm4x8(wg1.w));
   u1+=dot(x0,unpackSnorm4x8(wu1.x))+dot(x1,unpackSnorm4x8(wu1.y))+dot(x2,unpackSnorm4x8(wu1.z))+dot(x3,unpackSnorm4x8(wu1.w));
  }
 }
 g0=subgroupAdd(g0);u0=subgroupAdd(u0);g1=subgroupAdd(g1);u1=subgroupAdd(u1);
 if(lane==0u&&row<HIDDEN){
  g0*=127.0*uintBitsToFloat(scalar_word(e0+row));u0*=127.0*uintBitsToFloat(scalar_word(e0+row+HIDDEN));
  g1*=127.0*uintBitsToFloat(scalar_word(e1+row));u1*=127.0*uintBitsToFloat(scalar_word(e1+row+HIDDEN));
  output_data.values[row]=(g0/(1.0+exp(-g0)))*u0;output_data.values[HIDDEN+row]=(g1/(1.0+exp(-g1)))*u1;
 }
}
