#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer QueryGate { float v[]; } query_gate;
layout(set=0,binding=1,std430) readonly buffer KVCache { float v[]; } cache;
layout(set=0,binding=2,std430) writeonly buffer Context { float v[]; } context;
layout(set=0,binding=3,std430) readonly buffer Dummy { uint v; } dummy;
layout(push_constant) uniform P { uint layer; uint position; uint heads; uint unused; } p;
const uint HEAD_DIM=256u,KV_HEADS=2u,MAX_CONTEXT=2048u;shared float scores[MAX_CONTEXT];
void main(){uint lane=gl_LocalInvocationID.x,head=gl_WorkGroupID.x;if(head>=p.heads)return;uint count=p.position+1u,kv=head/(p.heads/KV_HEADS),lb=p.layer*2u*MAX_CONTEXT*KV_HEADS*HEAD_DIM;float maximum=-3.402823466e+38;
for(uint t=0u;t<count;++t){float dot=0.0;for(uint s=0u;s<4u;++s){uint d=lane+s*64u;dot+=query_gate.v[head*512u+d]*cache.v[lb+(t*KV_HEADS+kv)*HEAD_DIM+d];}dot=subgroupAdd(dot)*0.0625;if(lane==0u)scores[t]=dot;maximum=max(maximum,dot);}maximum=subgroupMax(maximum);barrier();float denom=0.0;for(uint t=0u;t<count;++t)denom+=exp(scores[t]-maximum);
for(uint s=0u;s<4u;++s){uint d=lane+s*64u;float outv=0.0;for(uint t=0u;t<count;++t)outv+=exp(scores[t]-maximum)/denom*cache.v[lb+MAX_CONTEXT*KV_HEADS*HEAD_DIM+(t*KV_HEADS+kv)*HEAD_DIM+d];context.v[head*HEAD_DIM+d]=outv;}}
