#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x=64, local_size_y=8, local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer QueryGate { float v[]; } query_gate;
layout(set=0,binding=1,std430) readonly buffer KVCache { uint v[]; } cache;
layout(set=0,binding=2,std430) writeonly buffer Scores { float v[]; } scores;
layout(push_constant) uniform P {
    uint position; uint max_context; uint block_size; uint representatives;
} p;

const uint HEAD_DIM=256u, KV_HEADS=2u, QUERY_HEADS=32u;
shared float tile_k[HEAD_DIM];
shared float head_scores[16];
float from_bf16(uint bits) { return uintBitsToFloat(bits<<16u); }

void main() {
    uint lane=gl_LocalInvocationID.x, local_head=gl_LocalInvocationID.y;
    uint block=gl_WorkGroupID.x/KV_HEADS, kv=gl_WorkGroupID.x%KV_HEADS;
    uint blocks=(p.position+p.block_size)/p.block_size;
    if(block>=blocks) return;
    uint begin=block*p.block_size;
    uint end=min(begin+p.block_size,p.position+1u);
    uint reps=p.representatives==0u ? end-begin : p.representatives;
    float best[2]; best[0]=-3.402823466e+38; best[1]=best[0];
    const uint pairs=HEAD_DIM/2u;
    for(uint r=0u;r<reps;++r){
        uint t=p.representatives==0u ? begin+r :
            min(end-1u,begin+((2u*r+1u)*(end-begin))/(2u*reps));
        if(local_head==0u)for(uint s=0u;s<2u;++s){uint pair=lane+s*64u;
            uint packed=cache.v[(t*KV_HEADS+kv)*pairs+pair];
            tile_k[pair*2u]=from_bf16(packed&0xffffu);
            tile_k[pair*2u+1u]=from_bf16(packed>>16u);}
        barrier();
        for(uint h=0u;h<2u;++h){uint head=kv*16u+local_head+h*8u;
            float dotv=query_gate.v[head*512u+lane]*tile_k[lane]
                +query_gate.v[head*512u+lane+64u]*tile_k[lane+64u]
                +query_gate.v[head*512u+lane+128u]*tile_k[lane+128u]
                +query_gate.v[head*512u+lane+192u]*tile_k[lane+192u];
            best[h]=max(best[h],subgroupAdd(dotv)*0.0625);}
        barrier();
    }
    if(lane==0u){head_scores[local_head]=best[0];head_scores[local_head+8u]=best[1];}
    barrier();
    if(lane==0u&&local_head==0u){float value=head_scores[0];
        for(uint h=1u;h<16u;++h)value=max(value,head_scores[h]);
        scores.v[kv*blocks+block]=value;}
}
