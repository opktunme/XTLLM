#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer A{float v[];}base_logits;
layout(set=0,binding=1,std430) readonly buffer B{float v[];}bias_logits;
layout(set=0,binding=2,std430) writeonly buffer O{float v[];}combined;
layout(push_constant) uniform P{uint count;uint base_offset;uint bias_offset;uint output_offset;}p;
void main(){uint i=gl_GlobalInvocationID.x;if(i<p.count)combined.v[p.output_offset+i]=base_logits.v[p.base_offset+i]+bias_logits.v[p.bias_offset+i];}
