void main(){uint linear=gl_GlobalInvocationID.x,per=p.rows*p.head_dim,t=gl_WorkGroupID.y,row=linear/p.head_dim,d=linear-row*p.head_dim;if(row>=p.rows||d>=p.head_dim)return;uint pos=(p.position_flags&0x3fffffffu)+t;bool inv=(p.position_flags&0x80000000u)!=0u;uint base=(t*p.rows+row)*p.head_dim;float value=input_data.v[base+d];uint start=p.head_dim-p.rope_dim;if(d>=start){uint local=d-start,pair=local>>1u,other=(local&1u)==0u?d+1u:d-1u;float x=input_data.v[base+d],y=input_data.v[base+other],c=cosines.v[pos*(p.rope_dim>>1u)+pair],s=sines.v[pos*(p.rope_dim>>1u)+pair];if(inv)s=-s;value=(local&1u)==0u?x*c-y*s:x*c+y*s;}output_data.v[base+d]=value;}
