#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Activations { vec4 values[]; } activations;
layout(set = 0, binding = 1, std430) readonly buffer ExpertArena { uint values[]; } expert_data;
layout(set = 0, binding = 2, std430) readonly buffer Routing { float values[]; } routing;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float values[]; } output_data;
layout(push_constant) uniform Params { uvec4 slots; } params;

const uint HIDDEN = 2880u;
const uint BLOCKS_PER_ROW = 90u;
const uint EXPERT_BLOCK_U32 = 3309120u;
const uint MLP1_SCALE_BYTE = 8294400u;
const uint MLP1_BIAS_BYTE = 8812800u;

uint load_byte(uint base, uint byte_offset) {
    const uint word = expert_data.values[base + (byte_offset >> 2u)];
    return (word >> ((byte_offset & 3u) * 8u)) & 255u;
}

float load_bf16(uint base, uint byte_offset) {
    const uint word = expert_data.values[base + (byte_offset >> 2u)];
    const uint bits = (word >> ((byte_offset & 2u) * 8u)) & 0xffffu;
    return uintBitsToFloat(bits << 16u);
}

vec4 fp4x4(uvec4 nibble) {
    const uvec4 magnitude = nibble & uvec4(7u);
    const uvec4 exponent = magnitude >> 1u;
    const uvec4 mantissa = magnitude & uvec4(1u);
    const uvec4 normal = ((uvec4(126u) + exponent) << 23u) |
                         (mantissa << 22u);
    const uvec4 subnormal = mantissa * uvec4(0x3f000000u);
    uvec4 bits = mix(normal, subnormal, equal(exponent, uvec4(0u)));
    bits |= (nibble & uvec4(8u)) << 28u;
    bits = mix(bits, uvec4(0u), equal(magnitude, uvec4(0u)));
    return uintBitsToFloat(bits);
}

float dot_word(uint packed, uint activation_index) {
    const vec4 low = fp4x4(uvec4(packed, packed >> 4u,
                                  packed >> 8u, packed >> 12u));
    const vec4 high = fp4x4(uvec4(packed >> 16u, packed >> 20u,
                                   packed >> 24u, packed >> 28u));
    return dot(activations.values[activation_index], low) +
           dot(activations.values[activation_index + 1u], high);
}

float block_dot(uint base, uint row, uint block) {
    const uint word_base = base + (row * BLOCKS_PER_ROW + block) * 4u;
    const uint input_base = block * 8u;
    return dot_word(expert_data.values[word_base], input_base) +
           dot_word(expert_data.values[word_base + 1u], input_base + 2u) +
           dot_word(expert_data.values[word_base + 2u], input_base + 4u) +
           dot_word(expert_data.values[word_base + 3u], input_base + 6u);
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint unit = gl_WorkGroupID.x * 4u + gl_LocalInvocationID.y;
    const uint rank = gl_WorkGroupID.y;
    const uint base = params.slots[rank] * EXPERT_BLOCK_U32;
    float gate = 0.0;
    float linear = 0.0;
    if (unit < HIDDEN) {
        const uint gate_row = unit * 2u;
        const uint linear_row = gate_row + 1u;
        for (uint block = lane; block < BLOCKS_PER_ROW; block += 64u) {
            const float gate_scale = uintBitsToFloat(
                load_byte(base, MLP1_SCALE_BYTE + gate_row * BLOCKS_PER_ROW + block) << 23u);
            const float linear_scale = uintBitsToFloat(
                load_byte(base, MLP1_SCALE_BYTE + linear_row * BLOCKS_PER_ROW + block) << 23u);
            gate += block_dot(base, gate_row, block) * gate_scale;
            linear += block_dot(base, linear_row, block) * linear_scale;
        }
    }
    gate = subgroupAdd(gate);
    linear = subgroupAdd(linear);
    if (lane == 0u && unit < HIDDEN) {
        gate += load_bf16(base, MLP1_BIAS_BYTE + unit * 4u);
        linear += load_bf16(base, MLP1_BIAS_BYTE + unit * 4u + 2u);
        const float limited_gate = min(gate, 7.0);
        const float limited_linear = clamp(linear, -7.0, 7.0);
        const float swish = limited_gate / (1.0 + exp(-1.702 * limited_gate));
        output_data.values[rank * HIDDEN + unit] = swish * (limited_linear + 1.0);
    }
}
