#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

// Exact deterministic top-k threshold selection. One bounded wave performs a
// 32-bit radix selection, then emits selected indices in ascending position order.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Scores{float v[];} scores;
layout(set=0,binding=1,std430) writeonly buffer Indices{uint v[];} indices;
layout(set=0,binding=2,std430) readonly buffer DummyA{uint v;} a;
layout(set=0,binding=3,std430) readonly buffer DummyB{uint v;} b;
layout(set=0,binding=4,std430) readonly buffer DummyC{uint v;} c;
layout(set=0,binding=5,std430) readonly buffer DummyD{uint v;} d;
layout(push_constant) uniform P{uint count;uint top_k;uint output_offset;uint value_offset;} p;

shared uint prefix,rank_value,threshold_key;
uint ordered(float x){uint u=floatBitsToUint(x);return u^((u&0x80000000u)!=0u?0xffffffffu:0x80000000u);}

void main(){
    uint lane=gl_LocalInvocationID.x;
    if(lane==0u){prefix=0u;rank_value=min(p.top_k,p.count);}barrier();
    for(int bit=31;bit>=0;--bit){
        uint ones=0u,mask=bit==31?0u:(0xffffffffu<<uint(bit+1));
        for(uint i=lane;i<p.count;i+=64u){uint key=ordered(scores.v[i]);if((key&mask)==prefix&&((key>>uint(bit))&1u)!=0u)++ones;}
        ones=subgroupAdd(ones);
        if(lane==0u){if(ones>=rank_value)prefix|=1u<<uint(bit);else rank_value-=ones;}
        barrier();
    }
    if(lane==0u){
        threshold_key=prefix;uint emitted=0u;
        for(uint i=0u;i<p.count&&emitted<p.top_k;++i)if(ordered(scores.v[i])>threshold_key)indices.v[p.output_offset+emitted++]=p.value_offset+i;
        for(uint i=0u;i<p.count&&emitted<p.top_k;++i)if(ordered(scores.v[i])==threshold_key)indices.v[p.output_offset+emitted++]=p.value_offset+i;
        while(emitted<p.top_k)indices.v[p.output_offset+emitted++]=0xffffffffu;
    }
}
