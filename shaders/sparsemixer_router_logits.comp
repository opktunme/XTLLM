#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer InputData{float values[];} input_data;
layout(set=0,binding=1,std430) readonly buffer RouterWeights{float values[];} weights;
layout(set=0,binding=2,std430) writeonly buffer RouterLogits{float values[];} logits;
layout(push_constant) uniform Params{uint dimension;uint experts;float jitter_epsilon;uint unused;}params;

void main(){
 const uint lane=gl_LocalInvocationID.x,expert=gl_WorkGroupID.x;
 float s0=0.0,s1=0.0,s2=0.0,s3=0.0;
 const uint base=expert*params.dimension;
 for(uint column=lane*4u;column<params.dimension;column+=256u){
  s0+=input_data.values[column]*weights.values[base+column];
  s1+=input_data.values[column+1u]*weights.values[base+column+1u];
  s2+=input_data.values[column+2u]*weights.values[base+column+2u];
  s3+=input_data.values[column+3u]*weights.values[base+column+3u];
 }
 const float sum=subgroupAdd((s0+s1)+(s2+s3));
 if(lane==0u)logits.values[expert]=sum;
}
