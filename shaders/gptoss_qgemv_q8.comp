#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Activations { vec4 values[]; } activations;
layout(set = 0, binding = 1, std430) readonly buffer MatrixBlock { uvec4 values[]; } matrix_data;
layout(set = 0, binding = 2, std430) readonly buffer Bias { float values[]; } bias_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float values[]; } output_data;
layout(push_constant) uniform Params { uint has_bias; uint columns; uint inner; uint packed_stride; } params;

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint row = gl_WorkGroupID.x * 4u + gl_LocalInvocationID.y;
    const uint vector_stride = params.packed_stride / 4u;
    float sum = 0.0;
    if (row < params.columns) {
        const uvec4 packed_scales = matrix_data.values[row >> 2u];
        const float scale = uintBitsToFloat(packed_scales[row & 3u]);
        const uint base = (params.columns + 3u) / 4u + row * vector_stride;
        for (uint v = lane; v < vector_stride; v += 64u) {
            const uvec4 w = matrix_data.values[base + v];
            const uint p = v * 4u;
            sum += dot(activations.values[p], unpackSnorm4x8(w.x));
            sum += dot(activations.values[p + 1u], unpackSnorm4x8(w.y));
            sum += dot(activations.values[p + 2u], unpackSnorm4x8(w.z));
            sum += dot(activations.values[p + 3u], unpackSnorm4x8(w.w));
        }
        sum = subgroupAdd(sum);
        if (lane == 0u) {
            const float bias = params.has_bias != 0u ? bias_data.values[row] : 0.0;
            output_data.values[row] = sum * (127.0 * scale) + bias;
        }
    }
}
