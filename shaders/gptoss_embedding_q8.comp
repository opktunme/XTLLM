#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer MatrixBlock { uint values[]; } matrix_data;
layout(set = 0, binding = 1, std430) readonly buffer TokenParameter { uint value; } token_parameter;
layout(set = 0, binding = 2, std430) writeonly buffer OutputData { float values[]; } output_data;
layout(set = 0, binding = 3, std430) readonly buffer Dummy { uint value; } dummy;
layout(push_constant) uniform Params { uint rows; uint columns; uint packed_stride; uint unused; } params;

void main() {
    const uint column = gl_GlobalInvocationID.x;
    if (column >= params.columns) return;
    const uint token = token_parameter.value;
    const float scale = uintBitsToFloat(matrix_data.values[token]);
    const uint weight_base = params.rows + token * params.packed_stride;
    const uint packed = matrix_data.values[weight_base + (column >> 2u)];
    const int quantized = bitfieldExtract(int(packed), int((column & 3u) * 8u), 8);
    output_data.values[column] = float(quantized) * scale;
}
