#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Run all ten routed Qwen3.8 experts in one dispatch.  WorkGroupID.y is
// the route rank and binding 1 contains the ten selected device addresses.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Act { uint v[]; } act;
layout(set=0,binding=1,std430) readonly buffer AddressTable { uint64_t v[]; } addresses;
layout(set=0,binding=2,std430) readonly buffer Routes { uint v[]; } routes;
layout(set=0,binding=3,std430) writeonly buffer Out { float v[]; } out_data;
layout(push_constant) uniform P { uint rank_unused; uint activation_scale_u32; uint unused0; uint unused1; } p;
layout(buffer_reference,std430,buffer_reference_align=4) readonly buffer ExpertData { uint v[]; };

const uint TOPK=10u,EDIM=640u,GROUPS=40u,WORDS=8u;
const uint GATE_S=0u,GATE_W=51200u,UP_S=870400u,UP_W=921600u;
uint sn(uint n){uint b=(n&15u)|((n&240u)<<4u)|((n&3840u)<<8u)|((n&61440u)<<12u);uint s=b&0x08080808u;return b|(s<<1u)|(s<<2u)|(s<<3u)|(s<<4u);}
int dq(uint w,uint a0,uint a1){return dotPacked4x8EXT(int(a0),int(sn(w&65535u)))+dotPacked4x8EXT(int(a1),int(sn(w>>16u)));}
float bf(ExpertData e,uint byte_offset,uint index){uint h=(e.v[(byte_offset>>2u)+(index>>1u)]>>((index&1u)*16u))&65535u;return uintBitsToFloat(h<<16u);}
float dotrow(ExpertData e,uint wb,uint sb,uint row,uint group,uint frag){uint wi=frag*4u;uint base=(wb>>2u)+row*(GROUPS*WORDS)+wi*GROUPS+group;uint ab=group*16u+wi*2u;int s=dq(e.v[base],act.v[ab],act.v[ab+1u]);s+=dq(e.v[base+GROUPS],act.v[ab+2u],act.v[ab+3u]);s+=dq(e.v[base+2u*GROUPS],act.v[ab+4u],act.v[ab+5u]);s+=dq(e.v[base+3u*GROUPS],act.v[ab+6u],act.v[ab+7u]);return float(s)*bf(e,sb,row*GROUPS+group)*uintBitsToFloat(act.v[p.activation_scale_u32+(group>>1u)]);}
void main(){uint rank=gl_WorkGroupID.y;if(rank>=TOPK)return;ExpertData e=ExpertData(addresses.v[rank]);uint lane=gl_LocalInvocationID.x,frag=lane&1u,lg=lane>>1u,first=gl_WorkGroupID.x*8u;float g[8]=float[8](0,0,0,0,0,0,0,0),u[8]=float[8](0,0,0,0,0,0,0,0);for(uint group=lg;group<GROUPS;group+=32u)for(uint r=0u;r<8u;++r){uint row=first+r;if(row<EDIM){g[r]+=dotrow(e,GATE_W,GATE_S,row,group,frag);u[r]+=dotrow(e,UP_W,UP_S,row,group,frag);}}for(uint r=0u;r<8u;++r){g[r]=subgroupAdd(g[r]);u[r]=subgroupAdd(u[r]);}if(lane==0u)for(uint r=0u;r<8u;++r){uint row=first+r;if(row<EDIM){float x=g[r];out_data.v[rank*EDIM+row]=(x/(1.0+exp(-x)))*u[r];}}}
