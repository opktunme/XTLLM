void main(){uint lane=gl_LocalInvocationID.x,gy=gl_WorkGroupID.y,gout=gy%p.groups,t=gy/p.groups,f=lane&1u,g0=lane>>1u,r0=gl_WorkGroupID.x*8u,ps=(p.inner+3u)>>2u,ss=(p.inner+127u)>>7u,ng=(p.inner+63u)>>6u,wpr=ng*8u,ab=t*p.groups*ps+gout*ps,sb=p.activation_scale_u32+t*p.groups*ss+gout*ss;float q[8]=float[8](0,0,0,0,0,0,0,0);for(uint kg=g0;kg<ng;kg+=32u){uint k=f*4u,aw=kg*16u+k*2u;uint a0=a.v[ab+aw],a1=a.v[ab+aw+1u],a2=a.v[ab+aw+2u],a3=a.v[ab+aw+3u],a4=a.v[ab+aw+4u],a5=a.v[ab+aw+5u],a6=a.v[ab+aw+6u],a7=a.v[ab+aw+7u];float as=uintBitsToFloat(a.v[sb+(kg>>1u)]);for(uint r=0u;r<8u;++r){uint lr=r0+r;if(lr<p.rows_per_group){uint row=gout*p.rows_per_group+lr,b=row*wpr+k*ng+kg;int d=dq(w.v[b],a0,a1)+dq(w.v[b+ng],a2,a3)+dq(w.v[b+2u*ng],a4,a5)+dq(w.v[b+3u*ng],a6,a7);q[r]+=float(d)*as*bs(row*ng+kg);}}}for(uint r=0u;r<8u;++r)q[r]=subgroupAdd(q[r]);if(lane==0u)for(uint r=0u;r<8u;++r){uint lr=r0+r;if(lr<p.rows_per_group){uint row=gout*p.rows_per_group+lr;o.v[t*p.groups*p.rows_per_group+row]=q[r];}}}
