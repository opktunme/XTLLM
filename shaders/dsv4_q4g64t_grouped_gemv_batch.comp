layout(push_constant) uniform P{uint groups;uint rows_per_group;uint inner;uint activation_scale_u32;}p;
uint sn(uint n){uint b=(n&15u)|((n&240u)<<4u)|((n&3840u)<<8u)|((n&61440u)<<12u);uint z=b&0x08080808u;return b|(z<<1u)|(z<<2u)|(z<<3u)|(z<<4u);}
