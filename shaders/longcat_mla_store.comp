layout(local_size_x=64,local_size_y=1,local_size_z=1) in;layout(set=0,binding=0,std430)buffer Query{float v[];}q;layout(set=0,binding=1,std430)readonly buffer KV{float v[];}kv;layout(set=0,binding=2,std430)readonly buffer Latent{float v[];}latent;layout(set=0,binding=3,std430)buffer Cache{float v[];}cache;layout(set=0,binding=4,std430)readonly buffer Rope{float v[];}rope;layout(push_constant)uniform P{uint block;uint position;uint max_context;uint unused;}p;const uint HEADS=32u,QSTRIDE=192u,KVSTRIDE=256u,CSTRIDE=320u;void main(){uint lane=gl_LocalInvocationID.x,h=gl_WorkGroupID.x;if(h>=HEADS)return;uint rb=p.position*64u;for(uint d=lane;d<64u;d+=64u){uint pair=d>>1u;float c=rope.v[rb+pair],s=rope.v[rb+32u+pair];uint qo=h*QSTRIDE+128u+d;float qv=q.v[qo];uint kd=512u+d;float kvv=latent.v[kd];if((d&1u)==0u){float qn=q.v[qo+1u],kn=latent.v[kd+1u];q.v[qo]=qv*c-qn*s;q.v[qo+1u]=qn*c+qv*s;uint base=(p.block*p.max_context+p.position)*HEADS*CSTRIDE+h*CSTRIDE;cache.v[base+128u+d]=kvv*c-kn*s;cache.v[base+128u+d+1u]=kn*c+kvv*s;}}barrier();uint base=(p.block*p.max_context+p.position)*HEADS*CSTRIDE+h*CSTRIDE;for(uint d=lane;d<128u;d+=64u){cache.v[base+d]=kv.v[h*KVSTRIDE+d];cache.v[base+192u+d]=kv.v[h*KVSTRIDE+128u+d];}}
