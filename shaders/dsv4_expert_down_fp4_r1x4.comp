#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Four independent one-row wave64 projections per workgroup.  The dispatched
// grid is finite and all subgroup operations remain wave-local.
layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer QuantizedIntermediate { uint values[]; } activations;
layout(set = 0, binding = 1, std430) readonly buffer ExpertRecord { uint values[]; } expert_data;
layout(set = 0, binding = 2, std430) readonly buffer RoutingData { uint values[]; } routing;
layout(set = 0, binding = 3, std430) buffer Accumulator { float values[]; } accumulator;
layout(push_constant) uniform Params {
    uint rank;
    uint activation_scale_u32;
    uint unused0;
    uint unused1;
} params;

const uint MODEL_DIM = 4096u;
const uint BLOCKS = 64u;
const uint WORDS_PER_ROW = 256u;
const uint W2_WEIGHT_U32 = 2228224u;
const uint W2_SCALE_BYTE = 13107200u;
const int FP4_X2[16] = int[16](0,1,2,3,4,6,8,12,0,-1,-2,-3,-4,-6,-8,-12);

uint load_scale_byte(uint byte_offset) {
    return (expert_data.values[byte_offset >> 2u] >> ((byte_offset & 3u) * 8u)) & 0xffu;
}
float ue8m0(uint code) { return uintBitsToFloat(code << 23u); }
uint pack4_fp4_x2(uint packed, uint nibble_base) {
    return (uint(FP4_X2[(packed >> (nibble_base + 0u)) & 15u]) & 255u) |
        ((uint(FP4_X2[(packed >> (nibble_base + 4u)) & 15u]) & 255u) << 8u) |
        ((uint(FP4_X2[(packed >> (nibble_base + 8u)) & 15u]) & 255u) << 16u) |
        ((uint(FP4_X2[(packed >> (nibble_base + 12u)) & 15u]) & 255u) << 24u);
}
int block_dot(uint row, uint block) {
    const uint wb = W2_WEIGHT_U32 + row * WORDS_PER_ROW + block * 4u;
    const uint ab = block * 8u;
    int sum = 0;
    for (uint i = 0u; i < 4u; ++i) {
        const uint w = expert_data.values[wb + i];
        sum += dotPacked4x8EXT(int(activations.values[ab + i * 2u]), int(pack4_fp4_x2(w, 0u)));
        sum += dotPacked4x8EXT(int(activations.values[ab + i * 2u + 1u]), int(pack4_fp4_x2(w, 16u)));
    }
    return sum;
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint row = gl_WorkGroupID.x * 4u + gl_LocalInvocationID.y;
    const uint block = lane;
    const float as = uintBitsToFloat(activations.values[params.activation_scale_u32 + block]);
    const float ws = ue8m0(load_scale_byte(W2_SCALE_BYTE + row * BLOCKS + block));
    float sum = float(block_dot(row, block)) * (0.5 * as * ws);
    sum = subgroupAdd(sum);
    if (lane == 0u && row < MODEL_DIM) {
        const float route_weight = uintBitsToFloat(routing.values[6u + params.rank]);
        accumulator.values[params.rank * MODEL_DIM + row] = sum * route_weight;
    }
}
