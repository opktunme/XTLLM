#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

// Exact, bounded online-softmax attention for Qwen3.6's 16Q/2KV, D=256
// full-attention layers. K/V are BF16 in budgeted host-visible memory.
layout(local_size_x=64, local_size_y=8, local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer QueryGate { float v[]; } query_gate;
layout(set=0,binding=1,std430) readonly buffer KVCache { uint v[]; } cache;
layout(set=0,binding=2,std430) writeonly buffer Partial { float v[]; } partial;
layout(set=0,binding=3,std430) readonly buffer Dummy { uint v; } dummy;
layout(push_constant) uniform P {
    uint position; uint max_context; uint chunk_size; uint chunks;
} p;

const uint HEAD_DIM=256u, KV_HEADS=2u, QUERY_HEADS=16u;
const uint HEADS_PER_GROUP=8u, PARTIAL_STRIDE=258u;
shared float tile_k[HEAD_DIM];
shared float tile_v[HEAD_DIM];
float from_bf16(uint bits){return uintBitsToFloat(bits<<16u);}

void main(){
    uint lane=gl_LocalInvocationID.x, local_head=gl_LocalInvocationID.y;
    uint chunk=gl_WorkGroupID.x/(QUERY_HEADS/HEADS_PER_GROUP);
    uint head_block=gl_WorkGroupID.x%(QUERY_HEADS/HEADS_PER_GROUP);
    uint head=head_block*HEADS_PER_GROUP+local_head;
    uint kv=head/(QUERY_HEADS/KV_HEADS);
    uint begin=chunk*p.chunk_size;
    uint end=min(min(begin+p.chunk_size,p.position+1u),p.max_context);
    const uint pairs=HEAD_DIM/2u;
    const uint value_base=p.max_context*KV_HEADS*pairs;
    float maximum=-3.402823466e+38, denominator=0.0;
    float o0=0.0,o1=0.0,o2=0.0,o3=0.0;
    for(uint t=begin;t<end;++t){
        if(local_head==0u)for(uint s=0u;s<2u;++s){
            uint pair=lane+s*64u;
            uint packed=cache.v[(t*KV_HEADS+kv)*pairs+pair];
            tile_k[pair*2u]=from_bf16(packed&0xffffu);
            tile_k[pair*2u+1u]=from_bf16(packed>>16u);
        }else if(local_head==1u)for(uint s=0u;s<2u;++s){
            uint pair=lane+s*64u;
            uint packed=cache.v[value_base+(t*KV_HEADS+kv)*pairs+pair];
            tile_v[pair*2u]=from_bf16(packed&0xffffu);
            tile_v[pair*2u+1u]=from_bf16(packed>>16u);
        }
        barrier();
        float dot=query_gate.v[head*512u+lane]*tile_k[lane]
            +query_gate.v[head*512u+lane+64u]*tile_k[lane+64u]
            +query_gate.v[head*512u+lane+128u]*tile_k[lane+128u]
            +query_gate.v[head*512u+lane+192u]*tile_k[lane+192u];
        float score=subgroupAdd(dot)*0.0625;
        float next=max(maximum,score), old=exp(maximum-next), add=exp(score-next);
        denominator=denominator*old+add;
        o0=o0*old+add*tile_v[lane]; o1=o1*old+add*tile_v[lane+64u];
        o2=o2*old+add*tile_v[lane+128u]; o3=o3*old+add*tile_v[lane+192u];
        maximum=next; barrier();
    }
    uint base=(chunk*QUERY_HEADS+head)*PARTIAL_STRIDE;
    if(lane==0u){partial.v[base]=maximum;partial.v[base+1u]=denominator;}
    partial.v[base+2u+lane]=o0; partial.v[base+66u+lane]=o1;
    partial.v[base+130u+lane]=o2; partial.v[base+194u+lane]=o3;
}
