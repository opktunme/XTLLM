#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) buffer Context { float v[]; } context;
layout(set=0,binding=1,std430) readonly buffer QueryGate { float v[]; } query_gate;
layout(set=0,binding=2,std430) readonly buffer DummyA { uint v; } a;
layout(set=0,binding=3,std430) readonly buffer DummyB { uint v; } b;
layout(push_constant) uniform P { uint count; uint heads; uint unused0; uint unused1; } p;
void main(){uint i=gl_GlobalInvocationID.x;if(i<p.count){uint h=i/256u,d=i%256u;context.v[i]*=1.0/(1.0+exp(-query_gate.v[h*512u+256u+d]));}}
