#version 450

layout(local_size_x=64, local_size_y=1, local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Approx { uint v[]; } approx_indices;
layout(set=0,binding=1,std430) readonly buffer Exact { uint v[]; } exact_indices;
layout(set=0,binding=2,std430) buffer Metrics { uint v[]; } metrics;
layout(push_constant) uniform P { uint selected; uint unused0; uint unused1; uint unused2; } p;

void main(){
    uint i=gl_GlobalInvocationID.x,total=2u*p.selected;
    if(i>=total)return;
    uint kv=i/p.selected,index=i%p.selected,needle=exact_indices.v[kv*64u+index];
    bool found=false;for(uint j=0u;j<p.selected;++j)found=found||(approx_indices.v[kv*64u+j]==needle);
    if(found)atomicAdd(metrics.v[0],1u);atomicAdd(metrics.v[1],1u);
}
