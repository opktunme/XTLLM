#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer GateData { float values[]; } gate_data;
layout(set = 0, binding = 1, std430) readonly buffer UpData { float values[]; } up_data;
layout(set = 0, binding = 2, std430) readonly buffer Dummy { uint value; } dummy;
layout(set = 0, binding = 3, std430) writeonly buffer OutputData { float values[]; } output_data;
layout(push_constant) uniform Params {
    uint count;
    uint limit_bits;
    uint gate_offset;
    uint up_offset;
} params;

const uint MAX_ELEMENTS = 8192u;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index >= min(params.count, MAX_ELEMENTS)) return;
    const float limit = uintBitsToFloat(params.limit_bits);
    const float gate = min(gate_data.values[params.gate_offset + index], limit);
    const float up = clamp(up_data.values[params.up_offset + index], -limit, limit);
    output_data.values[index] = (gate / (1.0 + exp(-gate))) * up;
}
