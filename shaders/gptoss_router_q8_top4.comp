#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer InputData { vec4 values[]; } input_data;
layout(set = 0, binding = 1, std430) readonly buffer RouterWeight { uint values[]; } weights;
layout(set = 0, binding = 2, std430) readonly buffer RouterBias { float values[]; } bias;
layout(set = 0, binding = 3, std430) writeonly buffer Routing { float values[]; } routing;
layout(push_constant) uniform Params { uint dimension; uint experts; uint top_k; uint unused; } params;

shared float logits[128];
shared uint quantized_input[720];
shared float input_scale;

float router_row(uint expert) {
    const float scale = input_scale * uintBitsToFloat(weights.values[expert]);
    const uint stride = params.dimension / 4u;
    const uint base = params.experts + expert * stride;
    int sum = 0;
    for (uint column = 0u; column < stride; ++column)
        sum += dotPacked4x8EXT(int(quantized_input[column]),
                              int(weights.values[base + column]));
    return float(sum) * scale + bias.values[expert];
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    float maximum = 0.0;
    for (uint column = lane; column < params.dimension / 4u; column += 64u) {
        const vec4 value = abs(input_data.values[column]);
        maximum = max(maximum, max(max(value.x, value.y), max(value.z, value.w)));
    }
    maximum = subgroupMax(maximum);
    if (lane == 0u) input_scale = maximum / 127.0;
    barrier();
    for (uint column = lane; column < params.dimension / 4u; column += 64u) {
        const ivec4 q = ivec4(clamp(round(input_data.values[column] / input_scale),
                                    vec4(-127.0), vec4(127.0)));
        quantized_input[column] = (uint(q.x) & 255u) |
                                  ((uint(q.y) & 255u) << 8u) |
                                  ((uint(q.z) & 255u) << 16u) |
                                  ((uint(q.w) & 255u) << 24u);
    }
    barrier();
    logits[lane] = router_row(lane);
    logits[lane + 64u] = router_row(lane + 64u);
    barrier();
    if (lane == 0u) {
        uint selected[4];
        float selected_logits[4];
        for (uint rank = 0u; rank < 4u; ++rank) {
            float best = -3.402823466e+38;
            uint best_index = 0u;
            for (uint expert = 0u; expert < 128u; ++expert) {
                bool used = false;
                for (uint prior = 0u; prior < rank; ++prior)
                    used = used || selected[prior] == expert;
                if (!used && logits[expert] > best) {
                    best = logits[expert];
                    best_index = expert;
                }
            }
            selected[rank] = best_index;
            selected_logits[rank] = best;
        }
        const float maximum_logit = max(max(selected_logits[0], selected_logits[1]),
                                        max(selected_logits[2], selected_logits[3]));
        float denominator = 0.0;
        for (uint rank = 0u; rank < 4u; ++rank) {
            selected_logits[rank] = exp(selected_logits[rank] - maximum_logit);
            denominator += selected_logits[rank];
        }
        for (uint rank = 0u; rank < 4u; ++rank) {
            routing.values[rank] = float(selected[rank]);
            routing.values[4u + rank] = selected_logits[rank] / denominator;
        }
    }
}
