#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Eight routed Qwen down projections in one finite dispatch.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Act { uint v[]; } act;
layout(set=0,binding=1,std430) readonly buffer AddressTable { uint64_t v[]; } addresses;
layout(set=0,binding=2,std430) readonly buffer Routes { uint v[]; } routes;
layout(set=0,binding=3,std430) writeonly buffer Out { float v[]; } out_data;
layout(push_constant) uniform P { uint rank_unused; uint activation_scale_u32; uint unused0; uint unused1; } p;
layout(buffer_reference,std430,buffer_reference_align=4) readonly buffer ExpertData { uint v[]; };

const uint TOPK=8u,DIM=3072u,EDIM=1024u,GROUPS=16u,WORDS=8u;
const uint DOWN_S=3342336u,DOWN_W=3440640u;
uint sn(uint n){uint b=(n&15u)|((n&240u)<<4u)|((n&3840u)<<8u)|((n&61440u)<<12u);uint s=b&0x08080808u;return b|(s<<1u)|(s<<2u)|(s<<3u)|(s<<4u);}
int dq(uint w,uint a0,uint a1){return dotPacked4x8EXT(int(a0),int(sn(w&65535u)))+dotPacked4x8EXT(int(a1),int(sn(w>>16u)));}
float bf(ExpertData e,uint index){uint h=(e.v[(DOWN_S>>2u)+(index>>1u)]>>((index&1u)*16u))&65535u;return uintBitsToFloat(h<<16u);}
void main(){uint rank=gl_WorkGroupID.y;if(rank>=TOPK)return;ExpertData e=ExpertData(addresses.v[rank]);uint lane=gl_LocalInvocationID.x,frag=lane&1u,group=lane>>1u,first=gl_WorkGroupID.x*8u;float sum[8]=float[8](0,0,0,0,0,0,0,0);if(group<GROUPS){uint wi=frag*4u;uint ab=rank*(EDIM/4u)+group*16u+wi*2u;float as=uintBitsToFloat(act.v[p.activation_scale_u32+rank*(EDIM/128u)+(group>>1u)]);for(uint r=0u;r<8u;++r){uint row=first+r;if(row<DIM){uint base=(DOWN_W>>2u)+row*(GROUPS*WORDS)+wi*GROUPS+group;int s=dq(e.v[base],act.v[ab],act.v[ab+1u]);s+=dq(e.v[base+GROUPS],act.v[ab+2u],act.v[ab+3u]);s+=dq(e.v[base+2u*GROUPS],act.v[ab+4u],act.v[ab+5u]);s+=dq(e.v[base+3u*GROUPS],act.v[ab+6u],act.v[ab+7u]);sum[r]+=float(s)*as*bf(e,row*GROUPS+group);}}}for(uint r=0u;r<8u;++r)sum[r]=subgroupAdd(sum[r]);if(lane==0u){float rw=uintBitsToFloat(routes.v[TOPK+rank]);for(uint r=0u;r<8u;++r){uint row=first+r;if(row<DIM)out_data.v[rank*DIM+row]=sum[r]*rw;}}}
