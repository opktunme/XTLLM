#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Pj{float v[];}proj;
layout(set=0,binding=1,std430) readonly buffer W{float v[];}w;
layout(set=0,binding=2,std430) readonly buffer B{float v[];}bias;
layout(set=0,binding=3,std430) buffer S{float v[];}state;
layout(set=0,binding=4,std430) writeonly buffer O{float v[];}outv;
layout(push_constant) uniform P{uint channels;uint kernel;uint u0;uint u1;}p;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.channels)return;uint b=i*p.kernel;for(uint k=0;k+1<p.kernel;k++)state.v[b+k]=state.v[b+k+1];state.v[b+p.kernel-1]=proj.v[4096u+i];float x=bias.v[i];for(uint k=0;k<p.kernel;k++)x+=state.v[b+k]*w.v[b+k];outv.v[i]=x/(1.0+exp(-x));}
