#version 450
#extension GL_KHR_shader_subgroup_shuffle : require

// A wave64 carries two independent 32-lane dot products. XOR shuffles never
// cross the half-wave boundary, eliminating shared memory without doubling
// the lane count per output row.
layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Activations { float values[]; } activations;
layout(set = 0, binding = 1, std430) readonly buffer PackedWeights { uint values[]; } weights;
layout(set = 0, binding = 2, std430) readonly buffer WeightScales { float values[]; } scales;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float values[]; } output_data;
layout(push_constant) uniform Params { uint rows; uint columns; uint inner; uint packed_stride; } params;

int signed_byte(uint packed, uint byte_index) {
    int value = int((packed >> (byte_index * 8u)) & 0xffu);
    return value >= 128 ? value - 256 : value;
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint row = gl_WorkGroupID.x * 8u + gl_LocalInvocationID.y;
    float sum = 0.0;
    if (row < params.columns) {
        const uint weight_base = row * params.packed_stride;
        for (uint packed_index = lane; packed_index < params.packed_stride; packed_index += 32u) {
            const uint packed = weights.values[weight_base + packed_index];
            const uint k = packed_index * 4u;
            if (k < params.inner) sum += activations.values[k] * float(signed_byte(packed, 0u));
            if (k + 1u < params.inner) sum += activations.values[k + 1u] * float(signed_byte(packed, 1u));
            if (k + 2u < params.inner) sum += activations.values[k + 2u] * float(signed_byte(packed, 2u));
            if (k + 3u < params.inner) sum += activations.values[k + 3u] * float(signed_byte(packed, 3u));
        }
    }
    for (uint offset = 16u; offset > 0u; offset >>= 1u) {
        sum += subgroupShuffleXor(sum, offset);
    }
    if (lane == 0u && row < params.columns) output_data.values[row] = sum * scales.values[row];
}
