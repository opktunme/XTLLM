#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Q{float v[];}q;
layout(set=0,binding=1,std430) readonly buffer K{float v[];}k;
layout(set=0,binding=2,std430) readonly buffer V{float v[];}v;
layout(set=0,binding=3,std430) buffer C{float v[];}cache;
