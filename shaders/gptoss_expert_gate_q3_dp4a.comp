#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Activations { uint values[]; } activations;
layout(set = 0, binding = 1, std430) readonly buffer ExpertArena { uint values[]; } expert_data;
layout(set = 0, binding = 2, std430) readonly buffer Routing { float values[]; } routing;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float values[]; } output_data;
layout(push_constant) uniform Params { uvec4 slots; } params;

const uint HIDDEN = 2880u;
const uint PACKED = 720u;
const uint BLOCKS_PER_ROW = 90u;
const uint EXPERT_BLOCK_U32 = 2531520u;
const uint MLP1_SCALE_BYTE = 6220800u;
const uint MLP1_BIAS_BYTE = 6739200u;

uint load_byte(uint base, uint byte_offset) {
    const uint word = expert_data.values[base + (byte_offset >> 2u)];
    return (word >> ((byte_offset & 3u) * 8u)) & 255u;
}
float load_bf16(uint base, uint byte_offset) {
    const uint word = expert_data.values[base + (byte_offset >> 2u)];
    return uintBitsToFloat(((word >> ((byte_offset & 2u) * 8u)) & 0xffffu) << 16u);
}
int q3_level(uint code) {
    if (code == 0u) return 0;
    const int pair = int((code + 1u) >> 1u);
    const int magnitude = pair * (pair + 3) / 2;
    return (code & 1u) != 0u ? magnitude : -magnitude;
}
uint pack4(uint packed) {
    return (uint(q3_level(packed & 7u)) & 255u) |
        ((uint(q3_level((packed >> 3u) & 7u)) & 255u) << 8u) |
        ((uint(q3_level((packed >> 6u) & 7u)) & 255u) << 16u) |
        ((uint(q3_level((packed >> 9u) & 7u)) & 255u) << 24u);
}
int dot8(uint packed, uint activation_word) {
    return dotPacked4x8EXT(int(activations.values[activation_word]), int(pack4(packed))) +
           dotPacked4x8EXT(int(activations.values[activation_word + 1u]),
                           int(pack4(packed >> 12u)));
}
int block_dot(uint base, uint row, uint block) {
    const uint word_base = base + (row * BLOCKS_PER_ROW + block) * 3u;
    const uint w0 = expert_data.values[word_base];
    const uint w1 = expert_data.values[word_base + 1u];
    const uint w2 = expert_data.values[word_base + 2u];
    const uint a = block * 8u;
    return dot8(w0 & 0xffffffu, a) +
           dot8((w0 >> 24u) | ((w1 & 0xffffu) << 8u), a + 2u) +
           dot8((w1 >> 16u) | ((w2 & 0xffu) << 16u), a + 4u) +
           dot8(w2 >> 8u, a + 6u);
}
void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint unit = gl_WorkGroupID.x * 4u + gl_LocalInvocationID.y;
    const uint rank = gl_WorkGroupID.y;
    const uint base = params.slots[rank] * EXPERT_BLOCK_U32;
    const float activation_scale = uintBitsToFloat(activations.values[PACKED]);
    float gate = 0.0, linear = 0.0;
    if (unit < HIDDEN) {
        const uint gate_row = unit * 2u;
        const uint linear_row = gate_row + 1u;
        for (uint block = lane; block < BLOCKS_PER_ROW; block += 64u) {
            const float gs = uintBitsToFloat(
                load_byte(base, MLP1_SCALE_BYTE + gate_row * BLOCKS_PER_ROW + block) << 23u);
            const float ls = uintBitsToFloat(
                load_byte(base, MLP1_SCALE_BYTE + linear_row * BLOCKS_PER_ROW + block) << 23u);
            gate += float(block_dot(base, gate_row, block)) * gs;
            linear += float(block_dot(base, linear_row, block)) * ls;
        }
    }
    gate = subgroupAdd(gate) * (activation_scale * 0.5);
    linear = subgroupAdd(linear) * (activation_scale * 0.5);
    if (lane == 0u && unit < HIDDEN) {
        gate += load_bf16(base, MLP1_BIAS_BYTE + unit * 4u);
        linear += load_bf16(base, MLP1_BIAS_BYTE + unit * 4u + 2u);
        const float limited_gate = min(gate, 7.0);
        const float limited_linear = clamp(linear, -7.0, 7.0);
        output_data.values[rank * HIDDEN + unit] =
            (limited_gate / (1.0 + exp(-1.702 * limited_gate))) * (limited_linear + 1.0);
    }
}
