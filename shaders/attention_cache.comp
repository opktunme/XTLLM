#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer AttentionState { float values[]; } state;
layout(set = 0, binding = 1, std430) writeonly buffer Context { float values[]; } context;

layout(push_constant) uniform Params {
    uint position;
    uint model_dimension;
    uint head_dimension;
    uint kv_dimension;
} params;

const uint MAX_SEQUENCE = 256;

void main() {
    const uint head = gl_GlobalInvocationID.x;
    const uint head_base = head * params.head_dimension;
    const uint query_heads = params.model_dimension / params.head_dimension;
    const uint kv_heads = params.kv_dimension / params.head_dimension;
    const uint kv_head = head / (query_heads / kv_heads);
    const uint kv_head_base = kv_head * params.head_dimension;
    const float scale = inversesqrt(float(params.head_dimension));
    float scores[MAX_SEQUENCE];
    float maximum = -3.402823466e+38;

    for (uint source = 0; source <= params.position; ++source) {
        const uint key_base = params.model_dimension + source * params.kv_dimension + kv_head_base;
        float score = 0.0;
        for (uint dimension = 0; dimension < params.head_dimension; ++dimension) {
            score += state.values[head_base + dimension] * state.values[key_base + dimension];
        }
        scores[source] = score * scale;
        maximum = max(maximum, scores[source]);
    }

    float denominator = 0.0;
    for (uint source = 0; source <= params.position; ++source) {
        scores[source] = exp(scores[source] - maximum);
        denominator += scores[source];
    }

    const uint value_cache_base = params.model_dimension + MAX_SEQUENCE * params.kv_dimension;
    for (uint dimension = 0; dimension < params.head_dimension; ++dimension) {
        float value = 0.0;
        for (uint source = 0; source <= params.position; ++source) {
            const uint value_index = value_cache_base + source * params.kv_dimension +
                                     kv_head_base + dimension;
            value += (scores[source] / denominator) * state.values[value_index];
        }
        context.values[head_base + dimension] = value;
    }
}
