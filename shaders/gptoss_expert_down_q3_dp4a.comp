#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Activations { uint values[]; } activations;
layout(set = 0, binding = 1, std430) readonly buffer ExpertArena { uint values[]; } expert_data;
layout(set = 0, binding = 2, std430) readonly buffer Routing { float values[]; } routing;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float values[]; } output_data;
layout(set = 0, binding = 4, std430) readonly buffer Residual { float values[]; } residual;
layout(push_constant) uniform Params { uvec4 slots; } params;

const uint DIMENSION = 2880u;
const uint HIDDEN = 2880u;
const uint PACKED = 720u;
const uint RANK_STRIDE = 721u;
const uint BLOCKS_PER_ROW = 90u;
const uint EXPERT_BLOCK_U32 = 2531520u;
const uint MLP2_BLOCK_U32 = 1687680u;
const uint MLP2_SCALE_BYTE = 9861120u;
const uint MLP2_BIAS_BYTE = 10120320u;

uint load_byte(uint base, uint byte_offset) {
    const uint word = expert_data.values[base + (byte_offset >> 2u)];
    return (word >> ((byte_offset & 3u) * 8u)) & 255u;
}
float load_bf16(uint base, uint byte_offset) {
    const uint word = expert_data.values[base + (byte_offset >> 2u)];
    return uintBitsToFloat(((word >> ((byte_offset & 2u) * 8u)) & 0xffffu) << 16u);
}
int q3_level(uint code) {
    if (code == 0u) return 0;
    const int pair = int((code + 1u) >> 1u);
    const int magnitude = pair * (pair + 3) / 2;
    return (code & 1u) != 0u ? magnitude : -magnitude;
}
uint pack4(uint packed) {
    return (uint(q3_level(packed & 7u)) & 255u) |
        ((uint(q3_level((packed >> 3u) & 7u)) & 255u) << 8u) |
        ((uint(q3_level((packed >> 6u) & 7u)) & 255u) << 16u) |
        ((uint(q3_level((packed >> 9u) & 7u)) & 255u) << 24u);
}
int dot8(uint packed, uint activation_base, uint activation_word) {
    return dotPacked4x8EXT(int(activations.values[activation_base + activation_word]),
                           int(pack4(packed))) +
           dotPacked4x8EXT(int(activations.values[activation_base + activation_word + 1u]),
                           int(pack4(packed >> 12u)));
}
int block_dot(uint base, uint row, uint block, uint activation_base) {
    const uint word_base = base + MLP2_BLOCK_U32 +
                           (row * BLOCKS_PER_ROW + block) * 3u;
    const uint w0 = expert_data.values[word_base];
    const uint w1 = expert_data.values[word_base + 1u];
    const uint w2 = expert_data.values[word_base + 2u];
    const uint a = block * 8u;
    return dot8(w0 & 0xffffffu, activation_base, a) +
           dot8((w0 >> 24u) | ((w1 & 0xffffu) << 8u), activation_base, a + 2u) +
           dot8((w1 >> 16u) | ((w2 & 0xffu) << 16u), activation_base, a + 4u) +
           dot8(w2 >> 8u, activation_base, a + 6u);
}
void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint row = gl_WorkGroupID.x * 4u + gl_LocalInvocationID.y;
    float total = 0.0;
    for (uint rank = 0u; rank < 4u; ++rank) {
        const uint base = params.slots[rank] * EXPERT_BLOCK_U32;
        const uint activation_base = rank * RANK_STRIDE;
        const float activation_scale = uintBitsToFloat(
            activations.values[activation_base + PACKED]);
        float sum = 0.0;
        if (row < DIMENSION) {
            for (uint block = lane; block < BLOCKS_PER_ROW; block += 64u) {
                const float scale = uintBitsToFloat(
                    load_byte(base, MLP2_SCALE_BYTE + row * BLOCKS_PER_ROW + block) << 23u);
                sum += float(block_dot(base, row, block, activation_base)) * scale;
            }
        }
        sum = subgroupAdd(sum) * (activation_scale * 0.5);
        if (lane == 0u && row < DIMENSION)
            total += (sum + load_bf16(base, MLP2_BIAS_BYTE + row * 2u)) *
                     routing.values[4u + rank];
    }
    if (lane == 0u && row < DIMENSION)
        output_data.values[row] = total + residual.values[row];
}
