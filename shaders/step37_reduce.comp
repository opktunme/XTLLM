#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Experts { float v[]; } experts;
layout(set=0,binding=1,std430) readonly buffer Shared { float v[]; } shared_data;
layout(set=0,binding=2,std430) buffer Hidden { float v[]; } hidden;
layout(set=0,binding=3,std430) readonly buffer Dummy { uint v; } dummy;
layout(push_constant) uniform P { uint count; uint ranks; uint unused0; uint unused1; } p;
void main(){uint i=gl_GlobalInvocationID.x;if(i<p.count){float s=shared_data.v[i];for(uint r=0u;r<p.ranks;++r)s+=experts.v[r*p.count+i];hidden.v[i]+=s;}}
