#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer PackedWeights { uint values[]; } weights;
layout(set = 0, binding = 1, std430) readonly buffer Scales { float values[]; } scales;
layout(set = 0, binding = 2, std430) writeonly buffer OutputData { float values[]; } output_data;
layout(set = 0, binding = 3, std430) readonly buffer TokenParameter { uint value; } token_parameter;
layout(push_constant) uniform Params { uint token_unused; uint dimension; uint packed_stride; uint unused; } params;

void main() {
    const uint column = gl_GlobalInvocationID.x;
    if (column >= params.dimension) return;
    const uint token = token_parameter.value;
    const uint packed = weights.values[token * params.packed_stride + (column >> 3u)];
    const int quantized = bitfieldExtract(int(packed), int((column & 7u) * 4u), 4);
    output_data.values[column] = float(quantized) * scales.values[token];
}
