#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x=64,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer InputData{float values[];}input_data;
layout(set=0,binding=1,std430) readonly buffer RouterWeights{float values[];}weights;
layout(set=0,binding=2,std430) writeonly buffer RoutingResult{float values[];}result;
layout(push_constant) uniform Params{uint dimension;uint experts;float jitter_epsilon;uint unused;}params;
shared float logits[16];

float expert_dot(uint expert,uint lane){
 float s0=0.0,s1=0.0,s2=0.0,s3=0.0;const uint base=expert*params.dimension;
 for(uint column=lane*4u;column<params.dimension;column+=256u){
  s0+=input_data.values[column]*weights.values[base+column];s1+=input_data.values[column+1u]*weights.values[base+column+1u];
  s2+=input_data.values[column+2u]*weights.values[base+column+2u];s3+=input_data.values[column+3u]*weights.values[base+column+3u];
 }
 return subgroupAdd((s0+s1)+(s2+s3));
}

void main(){
 const uint lane=gl_LocalInvocationID.x,wave=gl_LocalInvocationID.y;
 const float first_value=expert_dot(wave,lane),second_value=expert_dot(wave+8u,lane);
 if(lane==0u){logits[wave]=first_value;logits[wave+8u]=second_value;}
 barrier();
 if(gl_LocalInvocationIndex==0u){
  uint first=0u;float first_max=-3.402823466e+38;
  for(uint expert=0u;expert<16u;++expert)if(logits[expert]>first_max){first_max=logits[expert];first=expert;}
  float first_denominator=0.0;for(uint expert=0u;expert<16u;++expert){
   const float factor=max(abs(logits[expert]),first_max);const bool masked=((first_max-logits[expert])/factor)>(2.0*params.jitter_epsilon);
   if(!masked)first_denominator+=exp(logits[expert]-first_max);
  }
  uint second=first==0u?1u:0u;float second_max=logits[second];
  for(uint expert=0u;expert<16u;++expert)if(expert!=first&&logits[expert]>second_max){second_max=logits[expert];second=expert;}
  float second_denominator=0.0;for(uint expert=0u;expert<16u;++expert){if(expert==first)continue;
   const float factor=max(abs(logits[expert]),second_max);const bool masked=((second_max-logits[expert])/factor)>(2.0*params.jitter_epsilon);
   if(!masked)second_denominator+=exp(logits[expert]-second_max);
  }
  result.values[0]=float(first);result.values[1]=float(second);result.values[2]=1.0/first_denominator;result.values[3]=1.0/second_denominator;
 }
}
