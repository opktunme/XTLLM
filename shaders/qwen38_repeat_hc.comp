#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer InputData { float v[]; } input_data;
layout(set=0,binding=1,std430) writeonly buffer Hyper { float v[]; } hyper;
layout(set=0,binding=2,std430) readonly buffer DummyA { uint v; } a;
layout(set=0,binding=3,std430) readonly buffer DummyB { uint v; } b;
layout(push_constant) uniform P { uint dimension; uint branches; uint unused0; uint unused1; } p;
void main(){uint i=gl_GlobalInvocationID.x;if(i<p.dimension*p.branches)hyper.v[i]=input_data.v[i%p.dimension];}
