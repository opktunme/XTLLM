#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Key { float v[]; } key_data;
layout(set=0,binding=1,std430) readonly buffer Query { float v[]; } query_data;
layout(set=0,binding=2,std430) readonly buffer Value { float v[]; } value_data;
layout(set=0,binding=3,std430) writeonly buffer Gated { float v[]; } gated;
layout(push_constant) uniform P { uint dimension; uint branches; uint unused0; uint unused1; } p;
void main(){uint lane=gl_LocalInvocationID.x,b=gl_WorkGroupID.x;if(b>=p.branches)return;float dot=0.0;for(uint d=lane;d<p.dimension;d+=64u){uint i=b*p.dimension+d;dot+=key_data.v[i]*query_data.v[i];}dot=subgroupAdd(dot)/sqrt(float(p.dimension));float transformed=dot==0.0?0.0:sign(dot)*sqrt(max(abs(dot),1e-6));float gate=1.0/(1.0+exp(-transformed));for(uint d=lane;d<p.dimension;d+=64u)gated.v[b*p.dimension+d]=gate*value_data.v[d];}
